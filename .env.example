# ===========================================
# Apni Dukan — Environment Variables
# ===========================================
# Copy this file to server/.env and fill in your values

# Server
PORT=5000
NODE_ENV=development

# MongoDB (MUST use a replica set for transaction support)
# Local: mongodb://localhost:27017/apni-dukan?replicaSet=rs0
# Atlas: mongodb+srv://user:pass@cluster.mongodb.net/apni-dukan
MONGODB_URI=mongodb://localhost:27017/apni-dukan?replicaSet=rs0

# JWT Secrets (generate strong random strings for production)
JWT_ACCESS_SECRET=change-this-to-a-random-64-char-string
JWT_REFRESH_SECRET=change-this-to-another-random-64-char-string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:3000
