# Apni Dukan - Backend Server Environment Variables

# Server Port
PORT=5000

# Environment (development, production, test)
NODE_ENV=development

# MongoDB Connection String (Replica Set enabled for transactions)
MONGODB_URI=mongodb://localhost:27017/apni_dukan?replicaSet=rs0

# JWT Configuration
# Generate secure random strings: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_jwt_access_key_min_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_jwt_refresh_key_min_32_characters_long
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Client Application URL (CORS allowed origin)
CLIENT_URL=http://localhost:5173
